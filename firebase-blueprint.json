          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the message author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 40
        },
        "senderRole": {
          "type": "string",
          "description": "Whether sent by member or administrator.",
          "enum": ["member", "admin"]
        },
        "text": {
          "type": "string",
          "description": "Chat message content.",
          "minLength": 1,
          "maxLength": 600
        },
        "packId": {
          "type": "string",
