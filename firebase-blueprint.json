        "authorUid": {
          "type": "string",
          "description": "Creator Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Public display name of the board creator.",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Community board title.",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "description": "Short subtitle describing the board theme or challenge.",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Brief description of the custom board.",
          "maxLength": 240
        },
        "themeId": {
          "type": "string",
          "description": "3D arena visual theme ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "previewSwatches": {
          "type": "array",
          "description": "3-color hex swatch preview palette."
        },
        "ladders": {
          "type": "array",
          "description": "Bounded list of ladder definitions (max 20)."
        },
        "snakes": {
          "type": "array",
          "description": "Bounded list of snake definitions (max 20)."
        },
        "boardSettings": {
          "type": "object",
          "description": "3D board plinth shape, scale, material, and colors."
        },
        "tileConfig": {
          "type": "object",
          "description": "3D stone tile shape, texture, colors, numeral style, and visual effects."
        },
        "snakeConfig": {
          "type": "object",
          "description": "3D snake head model, scale pattern, finish, size, and palette."
        },
        "ladderConfig": {
          "type": "object",
          "description": "3D ladder model style, material style, width scale, and colors."
        },
        "environmentConfig": {
          "type": "object",
          "description": "3D sanctuary environment sky, props, fog, and lighting preset."
        },
        "visualEffects": {
          "type": "object",
          "description": "Particle style, density, glow, ambient intensity, and shadow preferences."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Explicit publication flag evaluated by Firestore list/get security rules."
        },
        "downloads": {
          "type": "integer",
          "description": "Total number of times players downloaded or played this community board."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "authorUid",
        "authorName",
        "name",
        "subtitle",
        "description",
        "themeId",
        "previewSwatches",
        "ladders",
        "snakes",
        "boardSettings",
        "tileConfig",
        "snakeConfig",
        "ladderConfig",
        "environmentConfig",
        "visualEffects",
        "isPublished",
        "downloads",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated player account document storing email (PII), game progression, Aether Coins balance, unlocked boards, achievements, and preferences."
    },
    "/users/{userId}/boards/{boardId}": {
      "schema": {
        "$ref": "#/entities/CustomBoard"
      },
      "description": "Owner-only subcollection of custom 3D boards created by the user."
    },
    "/users/{userId}/coinGifts/{giftId}": {
      "schema": {
        "$ref": "#/entities/CoinGift"
      },
      "description": "Admin-issued coin gift notifications owned by the recipient for real-time gift animations."
    },
    "/publicProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/PublicProfile"
      },
      "description": "PII-free public player profiles queried for global hall-of-fame standings."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Authoritative admin role directory managed strictly by the bootstrapped administrator."
    },
    "/activeRooms/{roomCode}": {
      "schema": {
        "$ref": "#/entities/ActiveRoom"
      },
      "description": "Live multiplayer rooms synced by the room host for cross-instance Admin Portal monitoring and public lobby discovery."
    },
    "/topupChats/{userId}": {
      "schema": {
        "$ref": "#/entities/TopUpChatThread"
      },
      "description": "Private 1-to-1 paid top-up chat thread between a verified member and the administrator."
    },
    "/topupChats/{userId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/TopUpChatMessage"
      },
      "description": "Immutable chat messages and admin coin adjustment logs inside a member's top-up thread."
    },
    "/friendships/{pairId}": {
      "schema": {
        "$ref": "#/entities/Friendship"
      },
      "description": "Participant-isolated friend requests, accepted friendships, and live room invites."
    },
    "/friendships/{pairId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/FriendChatMessage"
      },
      "description": "Participant-isolated 1-to-1 quick-chat messages between accepted friends."
    },
    "/communityBoards/{boardId}": {
      "schema": {
        "$ref": "#/entities/CommunityBoard"
      },
      "description": "PII-free publicly published community-created 3D boards that players can browse, preview in 3D, download, and play."
    }
  }
}
