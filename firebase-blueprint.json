{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated player account, PII, stats, achievements, and preferences owned exclusively by the user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified player email address (PII, owner-only access).",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Player display name shown in game.",
          "minLength": 1,
          "maxLength": 32
        },
        "archetypeIndex": {
          "type": "integer",
          "description": "Selected pawn archetype index (0-13)."
        },
        "diceSkinId": {
          "type": "string",
          "description": "Selected 3D dice skin identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "emoteSetId": {
          "type": "string",
          "description": "Equipped custom EmoteWheel set identifier.",
          "enum": ["classic_aether", "ember_valor", "astral_oracle", "serpent_guild", "sovereign_crown"],
          "minLength": 1,
          "maxLength": 40
        },
        "totalGames": {
          "type": "integer",
          "description": "Total matches played."
        },
        "wins": {
          "type": "integer",
          "description": "Total matches won."
        },
        "losses": {
          "type": "integer",
          "description": "Total matches lost."
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest single-match score."
        },
        "fastestWinTurns": {
          "type": "integer",
          "description": "Fewest turns to win (0 if no wins recorded yet)."
        },
        "laddersClimbed": {
          "type": "integer",
          "description": "Lifetime ladders climbed."
        },
        "snakesBitten": {
          "type": "integer",
          "description": "Lifetime snakes encountered."
        },
        "shieldsUsed": {
          "type": "integer",
          "description": "Lifetime shields activated."
        },
        "specialTilesHit": {
          "type": "integer",
          "description": "Lifetime special tiles triggered."
        },
        "onlineWins": {
          "type": "integer",
          "description": "Online multiplayer wins."
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "Bounded list of unlocked achievement IDs (max 24)."
        },
        "dailyStreak": {
          "type": "integer",
          "description": "Current daily challenge streak."
        },
        "loginStreak": {
          "type": "integer",
          "description": "Consecutive calendar login days streak."
        },
        "lastLoginDate": {
          "type": "string",
          "description": "Last local login date (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 16
        },
        "tutorialCompleted": {
          "type": "boolean",
          "description": "Whether interactive tutorial has been completed."
        },
        "muted": {
          "type": "boolean",
          "description": "Audio mute preference."
        },
        "selectedBoardId": {
          "type": "string",
          "description": "Active selected board ID.",
          "minLength": 1,
          "maxLength": 80
        },
        "aetherCoins": {
          "type": "integer",
          "description": "In-game Aether Coins balance used to unlock premium 3D boards."
        },
        "unlockedBoardIds": {
          "type": "array",
          "description": "Bounded list of unlocked 3D board IDs (max 30)."
        },
        "unlockedPawnIndices": {
          "type": "array",
          "description": "Bounded list of unlocked hero pawn archetype indices (0-13, max 14)."
        },
        "numericId": {
          "type": "string",
          "description": "Unique 9-digit numeric player ID derived for quick friend search.",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[0-9]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "archetypeIndex",
        "diceSkinId",
        "totalGames",
        "wins",
        "losses",
        "bestScore",
        "fastestWinTurns",
        "laddersClimbed",
        "snakesBitten",
        "shieldsUsed",
        "specialTilesHit",
        "onlineWins",
        "unlockedAchievements",
        "dailyStreak",
        "loginStreak",
        "lastLoginDate",
        "tutorialCompleted",
        "muted",
        "selectedBoardId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomBoard": {
      "title": "CustomBoard",
      "description": "User-created 3D fantasy board configuration stored as a subcollection under the owning user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Board document ID matching path boardId.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID matching parent userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Custom board title.",
          "minLength": 1,
          "maxLength": 60
        },
        "themeId": {
          "type": "string",
          "description": "3D arena visual theme ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "ladders": {
          "type": "array",
          "description": "Bounded list of ladder definitions (max 20)."
        },
        "snakes": {
          "type": "array",
          "description": "Bounded list of snake definitions (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "themeId",
        "ladders",
        "snakes",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
