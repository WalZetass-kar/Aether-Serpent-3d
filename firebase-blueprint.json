{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated player account, PII, stats, achievements, and preferences owned exclusively by the user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified player email address (PII, owner-only access).",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Player display name shown in game.",
          "minLength": 1,
          "maxLength": 32
        },
        "archetypeIndex": {
          "type": "integer",
          "description": "Selected pawn archetype index (0-3)."
        },
        "diceSkinId": {
          "type": "string",
          "description": "Selected 3D dice skin identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "totalGames": {
          "type": "integer",
          "description": "Total matches played."
        },
        "wins": {
          "type": "integer",
          "description": "Total matches won."
        },
        "losses": {
          "type": "integer",
          "description": "Total matches lost."
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest single-match score."
        },
        "fastestWinTurns": {
          "type": "integer",
          "description": "Fewest turns to win (0 if no wins recorded yet)."
        },
        "laddersClimbed": {
          "type": "integer",
          "description": "Lifetime ladders climbed."
        },
        "snakesBitten": {
          "type": "integer",
          "description": "Lifetime snakes encountered."
        },
        "shieldsUsed": {
          "type": "integer",
          "description": "Lifetime shields activated."
        },
        "specialTilesHit": {
          "type": "integer",
          "description": "Lifetime special tiles triggered."
        },
        "onlineWins": {
          "type": "integer",
          "description": "Online multiplayer wins."
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "Bounded list of unlocked achievement IDs (max 24)."
        },
        "dailyStreak": {
          "type": "integer",
          "description": "Current daily challenge streak."
        },
        "loginStreak": {
          "type": "integer",
          "description": "Consecutive calendar login days streak."
        },
        "lastLoginDate": {
          "type": "string",
          "description": "Last local login date (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 16
        },
        "tutorialCompleted": {
          "type": "boolean",
          "description": "Whether interactive tutorial has been completed."
        },
        "muted": {
          "type": "boolean",
          "description": "Audio mute preference."
        },
        "selectedBoardId": {
          "type": "string",
          "description": "Active selected board ID.",
          "minLength": 1,
          "maxLength": 80
        },
        "aetherCoins": {
          "type": "integer",
          "description": "In-game Aether Coins balance used to unlock premium 3D boards."
        },
        "unlockedBoardIds": {
          "type": "array",
          "description": "Bounded list of unlocked 3D board IDs (max 30)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "archetypeIndex",
        "diceSkinId",
        "totalGames",
        "wins",
        "losses",
        "bestScore",
        "fastestWinTurns",
        "laddersClimbed",
        "snakesBitten",
        "shieldsUsed",
        "specialTilesHit",
        "onlineWins",
        "unlockedAchievements",
        "dailyStreak",
        "loginStreak",
        "lastLoginDate",
        "tutorialCompleted",
        "muted",
        "selectedBoardId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomBoard": {
      "title": "CustomBoard",
      "description": "User-created 3D fantasy board configuration stored as a subcollection under the owning user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Board document ID matching path boardId.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID matching parent userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Custom board title.",
          "minLength": 1,
          "maxLength": 60
        },
        "themeId": {
          "type": "string",
          "description": "3D arena visual theme ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "ladders": {
          "type": "array",
          "description": "Bounded list of ladder definitions (max 20)."
        },
        "snakes": {
          "type": "array",
          "description": "Bounded list of snake definitions (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "themeId",
        "ladders",
        "snakes",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Sanitized public player card for leaderboard and multiplayer display without any PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Player UID matching document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public player display name.",
          "minLength": 1,
          "maxLength": 32
        },
        "archetypeIndex": {
          "type": "integer",
          "description": "Selected pawn archetype index (0-3)."
        },
        "diceSkinId": {
          "type": "string",
          "description": "Equipped 3D dice skin ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "wins": {
          "type": "integer",
          "description": "Total wins."
        },
        "totalGames": {
          "type": "integer",
          "description": "Total games played."
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest recorded score."
        },
        "onlineWins": {
          "type": "integer",
          "description": "Total online wins."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Explicit opt-in flag required for public leaderboard queries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "archetypeIndex",
        "diceSkinId",
        "wins",
        "totalGames",
        "bestScore",
        "onlineWins",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Privileged admin role record verified by Firestore rules to grant Admin Portal read/moderation capabilities.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the admin user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the admin user.",
          "minLength": 3,
          "maxLength": 254
        },
        "grantedBy": {
          "type": "string",
          "description": "UID or email of the administrator who granted the role.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "grantedBy",
        "createdAt"
      ]
    },
    "ActiveRoom": {
      "title": "ActiveRoom",
      "description": "Cross-network multiplayer room state synced by the room host for live room discovery and Admin Portal monitoring (never stores hidden admin winner overrides).",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique room join code matching document ID.",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display title of the room.",
          "minLength": 1,
          "maxLength": 60
        },
        "hostUid": {
          "type": "string",
          "description": "Firebase Auth UID of the host who created the room.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "description": "Display name of the host.",
          "minLength": 1,
          "maxLength": 40
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the room appears in public lobby discovery."
        },
        "boardMode": {
          "type": "string",
          "description": "Selected multiplayer game mode.",
          "enum": ["classic", "battle", "team", "time_attack"]
        },
        "boardName": {
          "type": "string",
          "description": "Name of the active 3D board.",
          "minLength": 1,
          "maxLength": 60
        },
        "themeId": {
          "type": "string",
          "description": "Active 3D board theme ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Current room lifecycle state.",
          "enum": ["lobby", "playing", "finished"]
        },
        "winnerId": {
          "type": "string",
          "description": "Player ID of the finished match winner, or empty string while active.",
          "maxLength": 128
        },
        "playerCount": {
          "type": "integer",
          "description": "Number of players currently inside the room."
        },
        "maxPlayers": {
          "type": "integer",
          "description": "Maximum allowed players in the room."
        },
        "turnCount": {
          "type": "integer",
          "description": "Elapsed turn count in the match."
        },
        "players": {
          "type": "array",
          "description": "Bounded list of up to 4 room participant summaries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "code",
        "name",
        "hostUid",
        "hostName",
        "isPublic",
        "boardMode",
        "boardName",
        "themeId",
        "status",
        "winnerId",
        "playerCount",
        "maxPlayers",
        "turnCount",
        "players",
        "createdAt",
        "updatedAt"
      ]
    },
    "TopUpChatThread": {
      "title": "TopUpChatThread",
      "description": "Private 1-to-1 paid Aether Coin top-up conversation thread between a verified member and the administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Member Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email of the member requesting top-up.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the member.",
          "minLength": 1,
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Order conversation status.",
          "enum": ["open", "pending_payment", "completed"]
        },
        "requestedPackName": {
          "type": "string",
          "description": "Most recently selected Aether Coin pack or Royal Pass label.",
          "maxLength": 80
        },
        "lastMessageText": {
          "type": "string",
          "description": "Preview snippet of the latest message.",
          "maxLength": 300
        },
        "lastSenderRole": {
          "type": "string",
          "description": "Role of the sender of the latest message.",
          "enum": ["member", "admin"]
        },
        "unreadByAdmin": {
          "type": "integer",
          "description": "Count of unread member messages awaiting admin reply."
        },
        "unreadByMember": {
          "type": "integer",
          "description": "Count of unread admin messages awaiting member view."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "status",
        "requestedPackName",
        "lastMessageText",
        "lastSenderRole",
        "unreadByAdmin",
        "unreadByMember",
        "createdAt",
        "updatedAt"
      ]
    },
    "TopUpChatMessage": {
      "title": "TopUpChatMessage",
      "description": "Individual immutable message inside a member's top-up chat subcollection, optionally recording an admin coin adjustment.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message document ID matching path messageId.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "threadUid": {
          "type": "string",
          "description": "Owning member UID matching parent userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the message author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 40
        },
        "senderRole": {
          "type": "string",
          "description": "Whether sent by member or administrator.",
          "enum": ["member", "admin"]
        },
        "text": {
          "type": "string",
          "description": "Chat message content.",
          "minLength": 1,
          "maxLength": 600
        },
        "packId": {
          "type": "string",
          "description": "Optional package ID referenced in an order request.",
          "maxLength": 40
        },
        "coinDelta": {
          "type": "integer",
          "description": "Signed Aether Coin delta applied by admin (0 for regular messages)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "threadUid",
        "senderUid",
        "senderName",
        "senderRole",
        "text",
        "packId",
        "coinDelta",
        "createdAt"
      ]
    },
    "CoinGift": {
      "title": "CoinGift",
      "description": "Administrator-issued Aether Coin gift delivered to a specific user ID to trigger a real-time celebratory coin animation on the recipient's screen.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Gift document ID matching path giftId.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientUid": {
          "type": "string",
          "description": "Recipient Firebase Auth UID matching parent userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "Administrator Firebase Auth UID who sent the gift.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display label of the gifting administrator.",
          "minLength": 1,
          "maxLength": 40
        },
        "amount": {
          "type": "integer",
          "description": "Positive number of Aether Coins gifted."
        },
        "message": {
          "type": "string",
          "description": "Optional celebratory note shown in the recipient's gift animation.",
          "maxLength": 200
        },
        "acknowledged": {
          "type": "boolean",
          "description": "Whether the recipient has viewed and dismissed the gift animation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "recipientUid",
        "senderUid",
        "senderName",
        "amount",
        "message",
        "acknowledged",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated player account document storing email (PII), game progression, Aether Coins balance, unlocked boards, achievements, and preferences."
    },
    "/users/{userId}/boards/{boardId}": {
      "schema": {
        "$ref": "#/entities/CustomBoard"
      },
      "description": "Owner-only subcollection of custom 3D boards created by the user."
    },
    "/users/{userId}/coinGifts/{giftId}": {
      "schema": {
        "$ref": "#/entities/CoinGift"
      },
      "description": "Admin-issued coin gift notifications owned by the recipient for real-time gift animations."
    },
    "/publicProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/PublicProfile"
      },
      "description": "PII-free public player profiles queried for global hall-of-fame standings."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Authoritative admin role directory managed strictly by the bootstrapped administrator."
    },
    "/activeRooms/{roomCode}": {
      "schema": {
        "$ref": "#/entities/ActiveRoom"
      },
      "description": "Live multiplayer rooms synced by the room host for cross-instance Admin Portal monitoring and public lobby discovery."
    },
    "/topupChats/{userId}": {
      "schema": {
        "$ref": "#/entities/TopUpChatThread"
      },
      "description": "Private 1-to-1 paid top-up chat thread between a verified member and the administrator."
    },
    "/topupChats/{userId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/TopUpChatMessage"
      },
      "description": "Immutable chat messages and admin coin adjustment logs inside a member's top-up thread."
    }
  }
}
