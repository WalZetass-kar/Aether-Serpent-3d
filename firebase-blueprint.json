          "maxLength": 32
        },
        "displayNameLower": {
          "type": "string",
          "description": "Lowercase normalized display name for prefix/friend search.",
          "minLength": 1,
          "maxLength": 32
        },
        "archetypeIndex": {
          "type": "integer",
          "description": "Selected pawn archetype index (0-13)."
        },
        "diceSkinId": {
          "type": "string",
          "description": "Equipped 3D dice skin ID.",
          "minLength": 1,
          "maxLength": 40
        },
        "wins": {
          "type": "integer",
          "description": "Total wins."
        },
        "totalGames": {
          "type": "integer",
          "description": "Total games played."
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest recorded score."
        },
        "onlineWins": {
          "type": "integer",
          "description": "Total online wins."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Explicit opt-in flag required for public leaderboard queries."
        },
        "numericId": {
          "type": "string",
          "description": "Unique 9-digit numeric player ID for friend lookup.",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[0-9]+$"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Whether the player currently has an active online session."
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the player's latest presence heartbeat."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "archetypeIndex",
        "diceSkinId",
        "wins",
        "totalGames",
        "bestScore",
        "onlineWins",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Privileged admin role record verified by Firestore rules to grant Admin Portal read/moderation capabilities.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the admin user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
