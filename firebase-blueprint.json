          "maxLength": 32
        },
        "user2Name": {
          "type": "string",
          "description": "Cached display name of user2.",
          "minLength": 1,
          "maxLength": 32
        },
        "user1Archetype": {
          "type": "integer",
          "description": "Selected pawn archetype index of user1 (0-13)."
        },
        "user2Archetype": {
          "type": "integer",
          "description": "Selected pawn archetype index of user2 (0-13)."
