rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'ihwalmaulana09@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'archetypeIndex', 'diceSkinId',
          'totalGames', 'wins', 'losses', 'bestScore', 'fastestWinTurns',
          'laddersClimbed', 'snakesBitten', 'shieldsUsed', 'specialTilesHit',
          'onlineWins', 'unlockedAchievements', 'dailyStreak',
          'loginStreak', 'lastLoginDate',
          'tutorialCompleted', 'muted', 'selectedBoardId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'archetypeIndex', 'diceSkinId',
          'totalGames', 'wins', 'losses', 'bestScore', 'fastestWinTurns',
          'laddersClimbed', 'snakesBitten', 'shieldsUsed', 'specialTilesHit',
          'onlineWins', 'unlockedAchievements', 'dailyStreak',
          'loginStreak', 'lastLoginDate',
          'tutorialCompleted', 'muted', 'selectedBoardId',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (request.auth.token.email == null || data.email == request.auth.token.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.archetypeIndex is int && data.archetypeIndex >= 0 && data.archetypeIndex <= 3
        && data.diceSkinId is string && data.diceSkinId.size() >= 1 && data.diceSkinId.size() <= 40
        && data.totalGames is int && data.totalGames >= 0 && data.totalGames <= 1000000
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.losses is int && data.losses >= 0 && data.losses <= 1000000
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 10000000
        && data.fastestWinTurns is int && data.fastestWinTurns >= 0 && data.fastestWinTurns <= 10000
        && data.laddersClimbed is int && data.laddersClimbed >= 0 && data.laddersClimbed <= 1000000
        && data.snakesBitten is int && data.snakesBitten >= 0 && data.snakesBitten <= 1000000
        && data.shieldsUsed is int && data.shieldsUsed >= 0 && data.shieldsUsed <= 1000000
        && data.specialTilesHit is int && data.specialTilesHit >= 0 && data.specialTilesHit <= 1000000
        && data.onlineWins is int && data.onlineWins >= 0 && data.onlineWins <= 1000000
        && data.unlockedAchievements is list && data.unlockedAchievements.size() <= 24
        && (data.unlockedAchievements.size() == 0 || (data.unlockedAchievements[0] is string && data.unlockedAchievements[0].size() <= 64))
        && data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 10000
        && data.loginStreak is int && data.loginStreak >= 1 && data.loginStreak <= 100000
        && data.lastLoginDate is string && data.lastLoginDate.size() >= 1 && data.lastLoginDate.size() <= 16
        && data.tutorialCompleted is bool
        && data.muted is bool
        && data.selectedBoardId is string && data.selectedBoardId.size() >= 1 && data.selectedBoardId.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomBoard(data, userId, boardId) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'name', 'themeId', 'ladders', 'snakes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'name', 'themeId', 'ladders', 'snakes', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == boardId && data.id.size() >= 1 && data.id.size() <= 80
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 40
        && data.ladders is list && data.ladders.size() <= 20
        && (data.ladders.size() == 0 || data.ladders[0] is map)
        && data.snakes is list && data.snakes.size() <= 20
        && (data.snakes.size() == 0 || data.snakes[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'archetypeIndex', 'diceSkinId',
          'wins', 'totalGames', 'bestScore', 'onlineWins', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'archetypeIndex', 'diceSkinId',
          'wins', 'totalGames', 'bestScore', 'onlineWins', 'isPublic',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && (data.uid == request.auth.uid || isAdmin()) && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.archetypeIndex is int && data.archetypeIndex >= 0 && data.archetypeIndex <= 3
        && data.diceSkinId is string && data.diceSkinId.size() >= 1 && data.diceSkinId.size() <= 40
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.totalGames is int && data.totalGames >= 0 && data.totalGames <= 1000000
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 10000000
        && data.onlineWins is int && data.onlineWins >= 0 && data.onlineWins <= 1000000
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidActiveRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'name', 'hostUid', 'hostName', 'isPublic', 'boardMode',
          'boardName', 'themeId', 'status', 'winnerId',
          'playerCount', 'maxPlayers', 'turnCount', 'players',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'name', 'hostUid', 'hostName', 'isPublic', 'boardMode',
          'boardName', 'themeId', 'status', 'winnerId',
          'playerCount', 'maxPlayers', 'turnCount', 'players',
          'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code == roomCode && data.code.size() >= 4 && data.code.size() <= 16
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 && (data.hostUid == request.auth.uid || isAdmin())
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40
        && data.isPublic is bool
        && data.boardMode is string && data.boardMode in ['classic', 'battle', 'team', 'time_attack']
        && data.boardName is string && data.boardName.size() >= 1 && data.boardName.size() <= 60
        && data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 40
        && data.status is string && data.status in ['lobby', 'playing', 'finished']
        && data.winnerId is string && data.winnerId.size() <= 128
        && data.playerCount is int && data.playerCount >= 1 && data.playerCount <= 4
        && data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 4
        && data.turnCount is int && data.turnCount >= 0 && data.turnCount <= 100000
        && data.players is list && data.players.size() >= 1 && data.players.size() <= 4 && data.players[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} — Private PII & Account State (Owner + Verified Admin Read)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'archetypeIndex', 'diceSkinId', 'tutorialCompleted', 'muted', 'selectedBoardId', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'archetypeIndex', 'diceSkinId',
            'totalGames', 'wins', 'losses', 'bestScore', 'fastestWinTurns',
            'laddersClimbed', 'snakesBitten', 'shieldsUsed', 'specialTilesHit',
            'onlineWins', 'unlockedAchievements', 'dailyStreak',
            'loginStreak', 'lastLoginDate',
            'tutorialCompleted', 'muted', 'selectedBoardId', 'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      // /users/{userId}/boards/{boardId} — Custom 3D Boards (Master Gate -> parent /users/{userId})
      match /boards/{boardId} {
        allow get: if isValidId(userId) && isValidId(boardId) && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId) && (
          (isOwner(userId) && resource.data.ownerUid == request.auth.uid)
          || isBootstrappedAdmin()
        );

        allow create: if isValidId(userId)
          && isValidId(boardId)
          && isOwner(userId)
          && isValidCustomBoard(incoming(), userId, boardId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(boardId)
          && isOwner(userId)
          && isValidCustomBoard(incoming(), userId, boardId)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'themeId', 'ladders', 'snakes', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isValidId(userId)
          && isValidId(boardId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // -------------------------------------------------------------------------
    // /publicProfiles/{userId} — PII-Free Public Leaderboard Projection
    // -------------------------------------------------------------------------
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId)
        && (isOwner(userId) || isAdmin() || (resource != null && resource.data.isPublic == true));
      allow list: if resource.data.isPublic == true || isBootstrappedAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'archetypeIndex', 'diceSkinId',
            'wins', 'totalGames', 'bestScore', 'onlineWins', 'isPublic', 'updatedAt'
          ]))
          ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'isPublic', 'updatedAt'
          ]))
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // /admins/{userId} — Admin Role Directory (Bootstrapped Admin Managed)
    // -------------------------------------------------------------------------
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(userId)
        && isBootstrappedAdmin()
        && isValidAdminRole(incoming(), userId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    // -------------------------------------------------------------------------
    // /activeRooms/{roomCode} — Live Multiplayer Room Sync (Host Managed + Admin Monitored)
    // -------------------------------------------------------------------------
    match /activeRooms/{roomCode} {
      allow get: if isValidId(roomCode)
        && isEmailVerified()
        && (isAdmin() || (resource != null && (resource.data.isPublic == true || resource.data.hostUid == request.auth.uid)));
      allow list: if isBootstrappedAdmin()
        || (isEmailVerified() && (resource.data.isPublic == true || resource.data.hostUid == request.auth.uid));

      allow create: if isValidId(roomCode)
        && isEmailVerified()
        && isValidActiveRoom(incoming(), roomCode)
        && incoming().hostUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(roomCode)
        && isEmailVerified()
        && isValidActiveRoom(incoming(), roomCode)
        && incoming().code == existing().code
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().hostUid == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'hostName', 'isPublic', 'boardMode', 'boardName',
          'themeId', 'status', 'winnerId', 'playerCount', 'maxPlayers',
          'turnCount', 'players', 'updatedAt'
        ]);

      allow delete: if isValidId(roomCode)
        && isEmailVerified()
        && (existing().hostUid == request.auth.uid || isAdmin());
    }
  }
}
